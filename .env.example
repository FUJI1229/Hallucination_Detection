OPENAI_API_KEY=your-openai-api-key
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-azure-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
HUGGINGFACE_HUB_TOKEN=your-hf-token
# Optional overrides
# HF_HOME=/path/to/huggingface/cache
# TRANSFORMERS_CACHE=/path/to/hf/transformers
# HF_DATASETS_CACHE=/path/to/hf/datasets
# TRITON_CACHE_DIR=/path/to/triton/cache
# BIOASQ_TRAIN_PATH=/path/to/bioasq/training11b.json
# CONDA_HOME=/opt/conda
# CONDA_ENV_NAME=hami
